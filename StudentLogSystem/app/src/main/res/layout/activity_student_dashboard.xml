<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_blue_to_white"
    tools:context=".StudentDashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Bar with Clean Circular Action Icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/app_logo_desc"
                android:src="@drawable/logo1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDashboardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dashboard"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue_dark" />

                <TextView
                    android:id="@+id/tvPortalSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Portal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#546E7A"
                    android:textAllCaps="true" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDarkMode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_toggle_dark_mode"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_dark_mode"
                app:tint="@color/primary_blue_dark" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/btn_logout"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="#D32F2F"
                app:cornerRadius="20dp" />

        </LinearLayout>

        <!-- Student Profile Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F8FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Student Welcome Name & Program/Year Capsule Badges -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvWelcomeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Welcome, Student"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue_dark"
                        android:layout_marginBottom="6dp" />

                    <!-- Capsule Chip Badges -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvWelcomeProgramYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BSCS • 3rd Year"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#0D47A1"
                            android:background="#1F0D47A1"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#22000000"
                    android:layout_marginBottom="16dp" />

                <!-- Student Number -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/lblStudentNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student Number"
                        android:textSize="11sp"
                        android:textColor="#546E7A"
                        android:textAllCaps="true"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvDashboardStudentNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2023-00123"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#15000000"
                    android:layout_marginBottom="12dp" />

                <!-- Last Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/lblLastname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Name"
                        android:textSize="11sp"
                        android:textColor="#546E7A"
                        android:textAllCaps="true"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvDashboardLastname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lastname"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#15000000"
                    android:layout_marginBottom="12dp" />

                <!-- First Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/lblFirstname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="First Name"
                        android:textSize="11sp"
                        android:textColor="#546E7A"
                        android:textAllCaps="true"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvDashboardFirstname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Firstname"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#15000000"
                    android:layout_marginBottom="12dp" />

                <!-- Middle Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/lblMiddlename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Middle Name"
                        android:textSize="11sp"
                        android:textColor="#546E7A"
                        android:textAllCaps="true"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvDashboardMiddlename"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Middle Name"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#15000000"
                    android:layout_marginBottom="12dp" />

                <!-- Academic Info: Program & Year Level -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/lblProgram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Program"
                            android:textSize="11sp"
                            android:textColor="#546E7A"
                            android:textAllCaps="true"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/tvDashboardProgram"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="BSCS"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_blue_dark" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblYearLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Year Level"
                            android:textSize="11sp"
                            android:textColor="#546E7A"
                            android:textAllCaps="true"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/tvDashboardYearLevel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="3rd Year"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_blue_dark" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Log Actions Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F8FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvHeadingActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heading_log_actions"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue_dark"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnTimeIn"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/btn_time_in"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:backgroundTint="#0D47A1"
                        app:cornerRadius="27dp" />

                    <Button
                        android:id="@+id/btnTimeOut"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/btn_time_out"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:backgroundTint="#1976D2"
                        app:cornerRadius="27dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Logs History Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F8FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvHeadingHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heading_log_history"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue_dark"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tvNoLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_no_logs"
                    android:textColor="#546E7A"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/layoutLogsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
